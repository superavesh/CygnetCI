<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Direct loads of /tickets/{id}/ (deep links) serve the prebuilt tickets list page,
             which detects the id from the URL and renders that ticket's detail inline. -->
        <rule name="TicketDetail" stopProcessing="true">
          <match url="^tickets/([0-9]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="/tickets/index.html" />
        </rule>
      </rules>

      <!-- Never cache the page HTML. With Next.js static export the *.html files keep the
           same name on every build, so without this the browser keeps serving a stale page
           that points at old styles after a redeploy. The hashed _next assets are immutable
           and still cached normally. -->
      <outboundRules>
        <preConditions>
          <preCondition name="IsHTML">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
        </preConditions>
        <rule name="NoCacheHTML" preCondition="IsHTML">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
        </rule>
      </outboundRules>
    </rewrite>
    <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
