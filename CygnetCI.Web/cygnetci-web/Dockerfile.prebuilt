# Build a Web image from the ALREADY-BUILT static export (the ./out folder).
# Use this when you run `npm run build` yourself and just want to package ./out.
# Build with:  docker build -f Dockerfile.prebuilt -t REGISTRY/cygnetci-web:latest .
#
# NOTE: ./out must be present in the build context. The default .dockerignore
# excludes it, so this file ships with its own Dockerfile.prebuilt.dockerignore
# (BuildKit picks that up automatically for `-f Dockerfile.prebuilt`).
FROM nginx:alpine
COPY out /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
